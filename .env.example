POSTGRES_PASSWORD=replace-with-random-password
DATABASE_URL=postgres://geza:replace-with-random-password@localhost:5439/geza
SESSION_SECRET=replace-with-at-least-32-random-characters
# Required for any access via a domain name (own reverse proxy, Plesk, Caddy, ...),
# exactly matching the browser's scheme+host(+port) - otherwise login and every
# other write request fail with "Ungültige Anfrage". Leave empty only for
# localhost/127.0.0.1 access. Local previews are noindex.
PUBLIC_URL=
GEZA_PORT=3080
# Configure provider credentials in Admin after first setup, or here.
TMDB_TOKEN=
TVDB_API_KEY=
TVDB_PIN=
PLEX_URL=
PLEX_TOKEN=
PLEX_ACCOUNT_ID=
PLEX_SERVER_ID=
PLEX_WEBHOOK_SECRET=
